# ============================================================================
# Exotica Service Platform — Local Development Environment Template
# ============================================================================
# Copy this file to .env and fill in the values below
# DO NOT commit .env to git (it's in .gitignore)
# ============================================================================

# Application Environment
ENVIRONMENT=local
LOG_LEVEL=DEBUG
APP_NAME=exotica-service-platform

# Database (Docker Compose: postgres service)
DATABASE_URL=postgresql+asyncpg://exotica:exotica_dev_password@postgres:5432/exotica_dev

# Redis Cache (Docker Compose: redis service)
REDIS_URL=redis://redis:6379/0

# JWT Authentication
JWT_SECRET_ARN=JWT_SECRET
SECRETS_PROVIDER=env
JWT_SECRET=dev-jwt-secret

# CORS — comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:8001

# ============================================================================
# ServiceTitan Integration (Sandbox)
# ============================================================================
# Leave blank to use MockServiceTitanConnector
SERVICETITAN_API_KEY=
SERVICETITAN_API_ENDPOINT=https://api.sandbox.servicetitan.com
SERVICETITAN_REQUEST_TIMEOUT=30

# ============================================================================
# QuickBooks Integration (Sandbox)
# ============================================================================
# Get these by running: scripts/quickbooks_oauth.py
# Step 1: Set QUICKBOOKS_CLIENT_ID and QUICKBOOKS_CLIENT_SECRET from Intuit dev portal
# Step 2: Run the script (it opens your browser for approval)
# Step 3: Copy the REALM_ID and REFRESH_TOKEN values below

QUICKBOOKS_CLIENT_ID=AB1tiXmYUxjQTZGKe24oMN79zNoGE34yY8RkiMPyKGD2Cyfpx2
QUICKBOOKS_CLIENT_SECRET=zCY9fa7xkwzYWdnQX8UrDE7FX8xjXkO1h1ORLL3z
QUICKBOOKS_REALM_ID=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REQUEST_TIMEOUT=30

# HTTP Retry Settings
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_FACTOR=0.3

# Idempotency
IDEMPOTENCY_RETENTION_HOURS=24
